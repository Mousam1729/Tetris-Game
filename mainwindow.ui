QMainWindow {
    background-color: #0b0f14;
}

QWidget {
    color: #e2e8f0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 13px;
}

QGroupBox {
    background-color: #121720;
    border: 1px solid #243042;
    border-radius: 8px;
    margin-top: 24px;
    padding: 12px;
    font-weight: bold;
    color: #38bdf8;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #121720;
}

QFrame.card {
    background-color: #121720;
    border: 1px solid #243042;
    border-radius: 8px;
    padding: 10px;
}

QLabel {
    color: #cbd5e1;
}

QLabel.statTitle {
    color: #94a3b8;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
}

QLabel.statValue {
    color: #38bdf8;
    font-size: 20px;
    font-weight: bold;
}

QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 9px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #3b82f6;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #64748b;
}

QPushButton#btnRestart {
    background-color: #dc2626;
}

QPushButton#btnRestart:hover {
    background-color: #ef4444;
}

QPushButton#btnPause {
    background-color: #d97706;
}

QPushButton#btnPause:hover {
    background-color: #f59e0b;
}

QPushButton#btnResetHigh {
    background-color: #334155;
    font-size: 11px;
    padding: 6px 10px;
}

QPushButton#btnResetHigh:hover {
    background-color: #475569;
}

QSpinBox {
    background-color: #1a2230;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox {
    background-color: #1a2230;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView {
    background-color: #1a2230;
    color: #f1f5f9;
    selection-background-color: #2563eb;
}

QCheckBox {
    color: #cbd5e1;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #1a2230;
    border: 1px solid #334155;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #3b82f6;
}

QStatusBar {
    background-color: #0d121a;
    color: #94a3b8;
    border-top: 1px solid #1e293b;
}
